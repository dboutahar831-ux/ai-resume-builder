# ═══════════════════════════════════════════════════════
# Nexly Backend — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_resume_builder

# Individual DB params (optional — overrides DATABASE_URL parts if set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_resume_builder
DB_USER=postgres
DB_PASSWORD=

# ─── Authentication ────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change_this_to_a_random_secret_key

# ─── AI Services (optional) ────────────────────────────
# Get your API key from https://console.groq.com
GROQ_API_KEY=

# ─── Email (optional) ──────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=

# ─── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── OAuth (optional) ──────────────────────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# LinkedIn: https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# Frontend URL (for OAuth redirect back)
# CLIENT_URL=http://localhost:5173
